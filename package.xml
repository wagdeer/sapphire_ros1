<?xml version="1.0"?>
<package format="2">
  <name>sapphire_ros1</name>
  <version>0.1.0</version>
  <description>Sapphire LiDAR-inertial odometry ROS 1 Noetic interface</description>

  <maintainer email="bindeer@users.noreply.github.com">bindeer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <build_depend>eigen</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>spdlog</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <build_export_depend>libpcl-all-dev</build_export_depend>
  <build_export_depend>spdlog</build_export_depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>rosunit</test_depend>

  <export/>
</package>
